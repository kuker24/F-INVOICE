# Copy to .env.local for local dev. Never commit real secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=change-me-min-16-chars
PDF_SIGNING_SECRET=change-me-min-16-chars
APP_ENCRYPTION_KEY=change-me-min-32-chars-reserved-mvp

# Optional seed script
# SEED_PASSWORD=password123

# Optional multi-instance rate limit (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Optional payment gateway (default: manual bank transfer)
# PAYMENT_GATEWAY=manual
# PAYMENT_GATEWAY=midtrans
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false
# PAYMENT_GATEWAY=xendit
# XENDIT_SECRET_KEY=
# XENDIT_CALLBACK_TOKEN=

# E2E (Playwright)
# E2E_BASE_URL=https://f-invoice-orpin.vercel.app
# E2E_PUBLIC_TOKEN=
